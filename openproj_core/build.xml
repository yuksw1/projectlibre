<project default="dist" basedir=".">
	<property file="build.properties"/>

	<path id="compile.class.path">
		<fileset dir="../openproj_contrib">
			<include name="openproj-contrib.jar" />
			<include name="openproj-script.jar" />
		</fileset>
		<fileset dir="../openproj_contrib/lib">
			<include name="*.jar" />
		</fileset>
		<pathelement location="../openproj_contrib/lib/jaxb-api-2.3.1.jar"/>
		<pathelement location="../openproj_contrib/lib/jaxb-core-2.3.0.1.jar"/>
		<pathelement location="../openproj_contrib/lib/jaxb-impl-2.3.3.jar"/>
		<pathelement location="../openproj_contrib/lib/activation-1.1.1.jar"/>
	</path>

	<target name="prepare">
		<mkdir dir="${build}"/>
		<mkdir dir="${dist}"/>
	</target>
	
	<target name="build" depends="prepare">
		<javac destdir="${build}"
			classpathref="compile.class.path"
			debug="off"
			nowarn="on"
			encoding="ISO-8859-1"
			source="1.8"
			target="1.8">
				<src path="${src}" />
				<include name="**/*" />
				<exclude name="**/version.properties" />
				<exclude name="test/**" />
		</javac>
	</target>
	
	
	<target name="dist" depends="build">
		<jar jarfile="${dist}/openproj-core.jar">
			<zipfileset dir="${build}" >
				<include name="**/*" />
			</zipfileset>
			<metainf dir="../openproj_build/license">
				<include name="**" />
			</metainf>
		</jar>   
	</target>	

	<target name="clean">
		<delete dir="${build}"/>
		<delete dir="${dist}"/>
	</target>

</project>
